import {
  "PaiGack/moon_shadow/mooninfo",
  "PaiGack/moon_shadow/gitinfo",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

options(
  targets: {
    "run_js.mbt": [ "js" ],
    "run_none.mbt": [ "wasm", "wasm-gc" ],
    "run_targets.mbt": [ "js", "native", "llvm" ],
  },
)
