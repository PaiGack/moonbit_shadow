import {
  "PaiGack/moon_shadow/mooninfo",
  "PaiGack/moon_shadow/gitinfo",
  "PaiGack/moon_shadow/gitx/gitcli",
  "PaiGack/moon_shadow/buildinfo",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/process",
}

// The generator starts a process to ask `git` and `moon`, so it is native only.
// `moon check --target js gen` therefore fails by design — see README.
supported_targets = "native"

pkgtype(kind: "executable")
