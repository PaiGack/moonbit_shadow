import {
  "PaiGack/moon_shadow/mooninfo",
  "PaiGack/moon_shadow/gitinfo",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

options(
  targets: {
    "run_js.mbt": [ "js" ],
    "run_none.mbt": [ "wasm", "native", "llvm" ],
    "run_wasm_gc.mbt": [ "wasm-gc" ],
  },
)
